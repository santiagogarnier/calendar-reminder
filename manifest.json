{
  "manifest_version": 3,
  "name": "Calendar AI Reminder",
  "version": "1.0",
  "description": "Te recuerda tus eventos importantes por mail",

    "permissions": [
        "identity",
        "alarms",
        "storage"
    ],

    "background" : {
        "service_worker": "background.js"

    },

    "action" : {
      "default_popup" : "popup.html"
    },
    "oauth2": {
  "client_id": "1003739751495-6ghv2aqnrdibcch356ac6r03g06l9t87.apps.googleusercontent.com",
  "scopes": [
    "https://www.googleapis.com/auth/calendar.readonly",
    "https://www.googleapis.com/auth/gmail.send",
    "https://www.googleapis.com/auth/userinfo.email"
  ]
}
}